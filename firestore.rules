rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true;
    }

    function admin() {
      return verified() && request.auth.token.get('admin', false) == true;
    }

    function owner(uid) {
      return verified() && request.auth.uid == uid;
    }

    function publishedCourse(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.published == true;
    }

    function publishedLesson(courseId, lessonId) {
      return publishedCourse(courseId)
        && get(/databases/$(database)/documents/courses/$(courseId)/lessons/$(lessonId)).data.published == true;
    }

    function validText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function validCourse(data) {
      return validText(data.title, 120)
        && validText(data.description, 2000)
        && data.level in ['beginner', 'intermediate', 'advanced']
        && data.minutes is int && data.minutes >= 1 && data.minutes <= 1440
        && data.thumbnail in ['morning', 'balance', 'studio']
        && data.published is bool;
    }

    function validLesson(data) {
      return validText(data.title, 120) && data.order is int
        && data.order >= 1 && data.order <= 10000 && data.published is bool
        && (!('youtubeVideoId' in data) || (data.youtubeVideoId is string
          && data.youtubeVideoId.matches('^[A-Za-z0-9_-]{11}$')));
    }

    match /courses/{courseId} {
      allow get, list: if admin() || resource.data.published == true;
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['title', 'description', 'level', 'minutes', 'thumbnail', 'published'])
        && validCourse(request.resource.data) && !request.resource.data.published;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'level', 'minutes', 'thumbnail', 'published'])
        && validCourse(request.resource.data);

      match /lessons/{lessonId} {
        allow get, list: if admin() || (publishedCourse(courseId) && resource.data.published == true);
        allow create: if admin()
          && exists(/databases/$(database)/documents/courses/$(courseId))
          && request.resource.data.keys().hasOnly(['title', 'order', 'published', 'youtubeVideoId'])
          && validLesson(request.resource.data) && !request.resource.data.published;
        allow update: if admin()
          && exists(/databases/$(database)/documents/courses/$(courseId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'order', 'published', 'youtubeVideoId'])
          && validLesson(request.resource.data);
      }
    }

    match /users/{uid}/enrollments/{courseId} {
      allow get, list, delete: if owner(uid);
      allow create: if owner(uid) && publishedCourse(courseId)
        && request.resource.data.keys().hasOnly(['enrolledAt'])
        && request.resource.data.enrolledAt == request.time;
    }

    match /users/{uid}/courses/{courseId}/lesson_progress/{lessonId} {
      allow get, list, delete: if owner(uid);
      allow create, update: if owner(uid)
        && publishedLesson(courseId, lessonId)
        && request.resource.data.keys().hasOnly(['completedAt'])
        && request.resource.data.completedAt == request.time;
    }

    match /admin_audit_logs/{entryId} {
      allow get: if admin();
      allow list: if admin() && request.query.limit <= 100;
    }
  }
}
